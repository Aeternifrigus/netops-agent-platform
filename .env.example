# All optional. With nothing set the app runs with an in-memory graph,
# no auth (local only) and /chat returning 503.

ENVIRONMENT=local

# Auth and multi-tenancy. Unset = open mode, which is refused outside local.
# The DB role must not have SUPERUSER or BYPASSRLS, or RLS is bypassed.
# DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/netops

# Must be >= 32 chars outside local:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=insecure-local-development-key
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# Neo4j. Unset = in-memory graph.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# Model key. Unset = /chat returns 503; /tools/* still work.
# GOOGLE_API_KEY=
