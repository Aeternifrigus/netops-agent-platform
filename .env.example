# All optional. With nothing set the app runs with an in-memory graph,
# no auth (local only) and /chat returning 503.

ENVIRONMENT=local

# Neo4j. Unset = in-memory graph.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# Model key. Unset = /chat returns 503; /tools/* still work.
# GOOGLE_API_KEY=
