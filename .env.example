# Local development defaults: in-memory graph, no auth, /chat returning 503.
# Without ENVIRONMENT the app assumes production and refuses to start
# unless DATABASE_URL and a strong JWT_SECRET are set.

ENVIRONMENT=local

# Run with no accounts or tenants. Only accepted with ENVIRONMENT=local,
# and ignored once DATABASE_URL is set.
ALLOW_OPEN_MODE=true

# Auth and multi-tenancy.
# The DB role must not have SUPERUSER or BYPASSRLS, or RLS is bypassed.
# DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/netops

# Must be >= 32 chars outside local:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=insecure-local-development-key
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# Background /chat runs (also needs DATABASE_URL). Start a worker with:
#   celery -A app.tasks:celery_app worker --loglevel=info
# BROKER_URL=redis://localhost:6379/0

# Neo4j. Unset = in-memory graph.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# Model key. Unset = /chat returns 503; /tools/* still work.
# GOOGLE_API_KEY=
